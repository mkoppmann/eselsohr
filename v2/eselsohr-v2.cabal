cabal-version:      2.4
name:               eselsohr-v2
version:            0.1.0.0
synopsis:           Eselsohr 2 bookmark manager
license:            EUPL-1.2
license-file:       LICENSE
maintainer:         mkoppmann <dev@mkoppmann.at>
author:             Michael Koppmann
tested-with:        GHC ==9.10.3
build-type:         Simple

library
    exposed-modules:
        Eselsohr.Article
        Eselsohr.Authorization
        Eselsohr.Capability
        Eselsohr.Id
        Eselsohr.Version
        Eselsohr.WebUrl
    other-modules:     Paths_eselsohr_v2
    autogen-modules:   Paths_eselsohr_v2
    hs-source-dirs:    src
    default-language:  GHC2024
    ghc-options:       -Wall
    build-depends:
        base ^>=4.20.2.0,
        bytestring ^>=0.12.2.0,
        containers ^>=0.7,
        idna2008 ^>=1.0.0.1,
        network-uri ^>=2.6.4.2,
        text ^>=2.1.3,
        time ^>=1.12.2,
        uuid-types ^>=1.0.6.1

executable eselsohr-v2
    main-is:          Main.hs
    hs-source-dirs:   app
    default-language: GHC2024
    ghc-options:      -Wall
    build-depends:
        base ^>=4.20.2.0,
        eselsohr-v2

test-suite eselsohr-v2-test
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    default-language: GHC2024
    ghc-options:      -Wall
    build-depends:
        base ^>=4.20.2.0,
        containers ^>=0.7,
        eselsohr-v2,
        tasty ^>=1.5.4,
        tasty-hunit ^>=0.10.2,
        tasty-quickcheck ^>=0.11.1,
        text ^>=2.1.3,
        time ^>=1.12.2
    other-modules:
        Articles
        Attenuation
        Authorization
        Capabilities
        Chains
        Values
