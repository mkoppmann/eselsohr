cabal-version:      3.0
name:               eselsohr-v2
version:            0.1.0.0
synopsis:           Eselsohr 2 bookmark manager
license:            EUPL-1.2
license-file:       LICENSE
maintainer:         mkoppmann <dev@mkoppmann.at>
author:             Michael Koppmann
tested-with:        GHC ==9.10.3
build-type:         Simple

common language
    default-language:   GHC2024
    default-extensions: OverloadedStrings

library
    import:            language
    exposed-modules:
        Eselsohr.Article
        Eselsohr.Authorization
        Eselsohr.Capability
        Eselsohr.Id
        Eselsohr.Store
        Eselsohr.Version
        Eselsohr.WebUrl
    other-modules:     Paths_eselsohr_v2
    autogen-modules:   Paths_eselsohr_v2
    hs-source-dirs:    src
    ghc-options:       -Wall
    build-depends:
        base ^>=4.20.2.0,
        bytestring ^>=0.12.2.0,
        containers ^>=0.7,
        effectful-core ^>=2.7.1.1,
        idna2008 ^>=1.0.0.1,
        network-uri ^>=2.6.4.2,
        text ^>=2.1.3,
        time ^>=1.12.2,
        uuid-types ^>=1.0.6.1

library sqlite-internal
    import:           language
    visibility:       private
    exposed-modules:
        Eselsohr.Store.SQLite.Articles
        Eselsohr.Store.SQLite.Bearer
        Eselsohr.Store.SQLite.Codec
        Eselsohr.Store.SQLite.Create
        Eselsohr.Store.SQLite.Grants
        Eselsohr.Store.SQLite.Open
        Eselsohr.Store.SQLite.Schema
    other-modules:
        Eselsohr.Store.SQLite.Internal.Authority
        Eselsohr.Store.SQLite.Internal.Random
        Eselsohr.Store.SQLite.Internal.Transaction
    hs-source-dirs:    persistence
    ghc-options:      -Wall
    build-depends:
        base ^>=4.20.2.0,
        base64-bytestring ^>=1.2.1.0,
        bytestring ^>=0.12.2.0,
        containers ^>=0.7,
        cryptohash-sha256 ^>=0.11.102.1,
        crypton ^>=1.1.5,
        direct-sqlite ^>=2.3.29,
        directory ^>=1.3.8.5,
        eselsohr-v2,
        filepath ^>=1.5.4.0,
        sqlite-simple ^>=0.4.19.0,
        text ^>=2.1.3,
        time ^>=1.12.2,
        unix ^>=2.8.7.0,
        uuid-types ^>=1.0.6.1

library store-runtime
    import:           language
    visibility:       private
    exposed-modules:  Eselsohr.Store.Runtime
    hs-source-dirs:   runtime
    ghc-options:      -Wall
    build-depends:
        base ^>=4.20.2.0,
        effectful-core ^>=2.7.1.1,
        eselsohr-v2,
        eselsohr-v2:sqlite-internal,
        text ^>=2.1.3,
        time ^>=1.12.2

library web
    import:           language
    visibility:       private
    exposed-modules:
        Eselsohr.Config
        Eselsohr.Web.Form
        Eselsohr.Web.Handler
        Eselsohr.Web.Html
        Eselsohr.Web.Page
        Eselsohr.Web.Route
        Eselsohr.Web.Server
    hs-source-dirs:   web
    ghc-options:      -Wall
    build-depends:
        base ^>=4.20.2.0,
        bytestring ^>=0.12.2.0,
        containers ^>=0.7,
        directory ^>=1.3.8.5,
        effectful-core ^>=2.7.1.1,
        eselsohr-v2,
        eselsohr-v2:store-runtime,
        filepath ^>=1.5.4.0,
        http-types ^>=0.12.6,
        lucid ^>=2.11.20260427,
        network-uri ^>=2.6.4.2,
        text ^>=2.1.3,
        time ^>=1.12.2,
        wai ^>=3.2.5,
        warp ^>=3.4.15

executable eselsohr-v2
    import:           language
    main-is:          Main.hs
    hs-source-dirs:   app
    ghc-options:      -Wall -threaded
    build-depends:
        base ^>=4.20.2.0,
        eselsohr-v2,
        eselsohr-v2:sqlite-internal,
        eselsohr-v2:store-runtime,
        eselsohr-v2:web,
        text ^>=2.1.3

test-suite eselsohr-v2-test
    import:           language
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test
    ghc-options:      -Wall
    build-depends:
        base ^>=4.20.2.0,
        containers ^>=0.7,
        effectful-core ^>=2.7.1.1,
        eselsohr-v2,
        tasty ^>=1.5.4,
        tasty-hunit ^>=0.10.2,
        tasty-quickcheck ^>=0.11.1,
        text ^>=2.1.3,
        time ^>=1.12.2
    other-modules:
        Articles
        Attenuation
        Authorization
        Capabilities
        Chains
        StoreInterface
        Values

test-suite eselsohr-v2-sqlite-test
    import:           language
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test-sqlite
    ghc-options:      -Wall -threaded
    other-modules:
        AddTests
        BearerTests
        CodecTests
        CreateTests
        GrantTests
        ReadTests
        RuntimeTests
        SchemaTests
        SqliteFixtures
        TitleTests
    build-depends:
        base ^>=4.20.2.0,
        base64-bytestring ^>=1.2.1.0,
        bytestring ^>=0.12.2.0,
        containers ^>=0.7,
        direct-sqlite ^>=2.3.29,
        directory ^>=1.3.8.5,
        effectful-core ^>=2.7.1.1,
        eselsohr-v2,
        eselsohr-v2:sqlite-internal,
        eselsohr-v2:store-runtime,
        filepath ^>=1.5.4.0,
        sqlite-simple ^>=0.4.19.0,
        tasty ^>=1.5.4,
        tasty-hunit ^>=0.10.2,
        tasty-quickcheck ^>=0.11.1,
        temporary ^>=1.3,
        text ^>=2.1.3,
        time ^>=1.12.2,
        unix ^>=2.8.7.0

test-suite eselsohr-v2-web-test
    import:           language
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    hs-source-dirs:   test-web
    ghc-options:      -Wall -threaded
    other-modules:
        AdditionTests
        BearerPageTests
        ConfigTests
        PageTests
        RawHttp
        RouteTests
        ServerTests
        WebFixtures
    build-depends:
        base ^>=4.20.2.0,
        bytestring ^>=0.12.2.0,
        case-insensitive ^>=1.2.1.0,
        containers ^>=0.7,
        directory ^>=1.3.8.5,
        eselsohr-v2,
        eselsohr-v2:sqlite-internal,
        eselsohr-v2:store-runtime,
        eselsohr-v2:web,
        filepath ^>=1.5.4.0,
        http-types ^>=0.12.6,
        network ^>=3.2.9.0,
        sqlite-simple ^>=0.4.19.0,
        tasty ^>=1.5.4,
        tasty-hunit ^>=0.10.2,
        tasty-quickcheck ^>=0.11.1,
        temporary ^>=1.3,
        text ^>=2.1.3,
        time ^>=1.12.2,
        wai ^>=3.2.5,
        warp ^>=3.4.15
